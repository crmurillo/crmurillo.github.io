---
layout: layouts/page.liquid
title: Archive
permalink: /archive/
---
<div class="archive">
  <div class="timeline">
    {%- for group in collections.postsByYear %}
    <div class="archive-title">
      <h2 class="archive-year">{{ group.year }}</h2>
    </div>
    <ul>
      {%- for post in group.posts %}
      <li>
        <time datetime="{{ post.date | isoDate }}">{{ post.date | archiveDate }}</time>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </li>
      {%- endfor %}
    </ul>
    {%- endfor %}
  </div>
</div>
