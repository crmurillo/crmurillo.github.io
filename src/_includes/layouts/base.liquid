<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="author" content="{{ site.author.name }}">
  <meta name="description" content="{{ description | default: site.description | escape }}">
  <meta name="theme-color" content="#f5f5f5">
  <title>{% if title %}{{ title | escape }} | {% endif %}{{ site.title | escape }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;1,400&family=Roboto+Mono&display=swap">
  <link rel="stylesheet" href="/css/journal.css">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/images/favicon.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
</head>
<body>
  <header class="site-header">
    <div class="container">
      {% include "header.liquid" %}
    </div>
  </header>

  <div class="container">
    <main>
      {{ content }}
    </main>
    <footer>
      &copy; {{ "now" | date: "%Y" }} {{ site.author.name }}. Built with <a href="https://www.11ty.dev/">Eleventy</a>,
      styled after <a href="https://github.com/renyuanz/leonids">Leonids</a>.
    </footer>
  </div>
</body>
</html>
