---
layout: layouts/base.liquid
---
{%- assign ownTags = tags | postTags -%}
<a class="btn" href="/">Home</a>

<div id="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <span class="post-meta">
      <time class="post-date" datetime="{{ page.date | isoDate }}">{{ page.date | postDate }}</time>
      •
      <span class="read-time">{{ content | readingTime }}</span>
      {%- if ownTags.size > 0 %}
      •
      {%- for tag in ownTags %}
      <a class="post-tag" href="/tags/#{{ tag | slugify }}">{{ tag }}</a>{% unless forloop.last %} <span>/</span>{% endunless %}
      {%- endfor %}
      {%- endif %}
    </span>
  </header>

  <article class="post-content">
    {{ content }}
  </article>
</div>

{%- assign prev = collections.posts | getPreviousCollectionItem -%}
{%- assign next = collections.posts | getNextCollectionItem -%}
{%- if prev or next %}
<nav class="post-navigation" aria-label="Adjacent posts">
  <div class="post-nav-prev">
    {%- if prev %}
    <a href="{{ prev.url }}" title="{{ prev.data.title | escape }}"><span class="post-nav-arrow">&lsaquo;</span> <span class="post-nav-title">{{ prev.data.title | truncate: 40 | escape }}</span></a>
    {%- endif %}
  </div>
  <div class="post-nav-next">
    {%- if next %}
    <a href="{{ next.url }}" title="{{ next.data.title | escape }}"><span class="post-nav-title">{{ next.data.title | truncate: 40 | escape }}</span> <span class="post-nav-arrow">&rsaquo;</span></a>
    {%- endif %}
  </div>
</nav>
{%- endif %}
